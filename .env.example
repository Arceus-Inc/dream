# Example .env.local — copy to .env.local and fill in.
# .env.local is git-ignored. See README for the variable contract.

DREAM_SMOKE_NAME=azure-primary
DREAM_SMOKE_LABEL=primary
DREAM_SMOKE_API_KEY=<your-key>
DREAM_SMOKE_BASE_URL=https://<your-resource>.cognitiveservices.azure.com/openai/v1
DREAM_SMOKE_MODEL=<your-deployment>
DREAM_SMOKE_MAX_WINDOW=128000
DREAM_SMOKE_TIMEOUT=60
